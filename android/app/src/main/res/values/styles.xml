<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main app theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorPrimaryDark">#FFFFFF</item>
        <item name="colorAccent">#0F766E</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>

    <!-- Main theme after splash screen -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionModeOverlay">true</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>

    <!-- Android 12+ native splash screen -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">

        <!-- White splash background -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>

        <!-- Use the smaller / padded splash logo -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>

        <!-- Keep icon background white -->
        <item name="windowSplashScreenIconBackgroundColor">#FFFFFF</item>

        <!-- Theme after splash finishes -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>

    </style>

</resources>